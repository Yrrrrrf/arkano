{
  "name": "arkane",
  "version": "1.0.0",
  "description": "Universal Svelte 5 Runes Conduit for React 19 & Vue 3.5",
  "license": "MIT",
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": ["deno.ns", "dom", "esnext"]
  },
  "workspace": [
    "./packages/*"
  ],
  "imports": {
    "@arkane/core": "./packages/core/src/index.ts",
    "@arkane/react": "./packages/react/src/index.ts",
    "@arkane/vue": "./packages/vue/src/index.ts",
    "@arkane/vite": "./packages/vite/src/index.ts",
    "@arkane/cli": "./packages/cli/src/index.ts",
    "svelte": "npm:svelte@^5.0.0",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@latest",
    "react": "npm:react@^19.0.0",
    "react-dom": "npm:react-dom@^19.0.0",
    "@types/react": "npm:@types/react@^19.0.0",
    "@types/react-dom": "npm:@types/react-dom@^19.0.0",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@latest",
    "@testing-library/react": "npm:@testing-library/react@latest",
    "vue": "npm:vue@^3.5.0",
    "@vitejs/plugin-vue": "npm:@vitejs/plugin-vue@latest",
    "@vue/test-utils": "npm:@vue/test-utils@latest",
    "vite": "npm:vite@^6.0.0",
    "arktype": "npm:arktype@^2.0.0",
    "@cliffy/command": "jsr:@cliffy/command@1.0.0-rc.7",
    "@cliffy/table": "jsr:@cliffy/table@1.0.0-rc.7",
    "@cliffy/ansi": "jsr:@cliffy/ansi@1.0.0-rc.7",
    "vite-plus": "npm:vite-plus@latest",
    "tsdown": "npm:tsdown@latest",
    "jsdom": "npm:jsdom@latest",
    "@std/fs": "jsr:@std/fs@^1.0.14"
  }
}