{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	"root": false,
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"src/**",
			"fixtures/**",
			"config/**",
			"scripts/**",
			"!**/dist",
			"!**/build",
			"!**/node_modules",
			"!**/.svelte-kit",
			"!**/.svelte-check",
			"!**/.vite"
		]
	},
	"overrides": [
		{
			"includes": ["**/*.svelte"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off"
					}
				}
			}
		}
	]
}
