{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	"root": false,
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"src/**",
			"fixtures/**",
			"config/**",
			"scripts/**",
			"!**/dist",
			"!**/build",
			"!**/node_modules",
			"!**/.svelte-kit",
			"!**/.vite",
			"!**/.justcache"
		]
	},
	"overrides": [
		{
			"includes": ["**/*.svelte"]
		}
	]
}
